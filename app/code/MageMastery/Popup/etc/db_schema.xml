<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="magemastery_popup" resource="default" engine="innodb" comment="MageMastery Popup Table">
        <column xsi:type="int" name="popup_id" unsigned="true" nullable="false" identity="true" comment="Popup ID"/>
        <column xsi:type="text" name="name" nullable="false" comment="Popup Name"/>
        <column xsi:type="mediumtext" name="content" nullable="true" comment="Popup Contents"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" on_update="false" comment="Popup created time"/>
        <column xsi:type="timestamp" name="updated_at" nullable="true" on_update="false" comment="Popup modification time"/>
        <column xsi:type="smallint" name="is_active" unsigned="false" nullable="false" default="1" comment="Popup is active"/>
        <column xsi:type="smallint" name="timeout" unsigned="false" nullable="false" default="1" comment="Popup timeout"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="popup_id"/>
        </constraint>

    </table>
</schema>
